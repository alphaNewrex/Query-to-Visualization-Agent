{
  "$defs": {
    "Aggregate": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "aggregate",
          "type": "string"
        },
        "dimension": {
          "description": "What trials are counted by: a category, a date or enrollment size.",
          "enum": [
            "phase",
            "overall_status",
            "study_type",
            "sponsor_class",
            "intervention_type",
            "sex",
            "age_group",
            "allocation",
            "masking",
            "primary_purpose",
            "has_results",
            "country",
            "sponsor",
            "drug",
            "condition",
            "start_date",
            "primary_completion_date",
            "completion_date",
            "first_posted_date",
            "enrollment"
          ],
          "type": "string"
        },
        "series": {
          "anyOf": [
            {
              "enum": [
                "phase",
                "overall_status",
                "study_type",
                "sponsor_class",
                "intervention_type",
                "sex",
                "age_group",
                "allocation",
                "masking",
                "primary_purpose",
                "has_results"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "A second, closed dimension that splits the first; null otherwise."
        },
        "time_unit": {
          "anyOf": [
            {
              "enum": [
                "year",
                "quarter",
                "month"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Only for date dimensions; null lets the service use year."
        },
        "top_n": {
          "anyOf": [
            {
              "maximum": 500,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Only when the user asks for a number of items; otherwise null."
        }
      },
      "required": [
        "kind",
        "dimension",
        "series",
        "time_unit",
        "top_n"
      ],
      "title": "Aggregate",
      "type": "object"
    },
    "Clarify": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "clarify",
          "type": "string"
        },
        "reason": {
          "enum": [
            "missing_entity",
            "ambiguous_request"
          ],
          "type": "string"
        },
        "missing": {
          "items": {
            "enum": [
              "drug_name",
              "condition",
              "sponsor",
              "country",
              "compare",
              "group_by"
            ],
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "kind",
        "reason",
        "missing"
      ],
      "title": "Clarify",
      "type": "object"
    },
    "Entity": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "drug",
            "condition",
            "sponsor",
            "country",
            "term"
          ],
          "type": "string"
        },
        "value": {
          "description": "The words exactly as they appear in the question or in a structured field. Never translate, expand, correct or add a name.",
          "type": "string"
        },
        "role": {
          "description": "'filter': every counted trial must match. 'compare': one side of an 'A vs B' comparison.",
          "enum": [
            "filter",
            "compare"
          ],
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value",
        "role"
      ],
      "title": "Entity",
      "type": "object"
    },
    "FilterEvidence": {
      "additionalProperties": false,
      "properties": {
        "family": {
          "enum": [
            "phases",
            "statuses",
            "study_types",
            "sponsor_classes",
            "intervention_types"
          ],
          "type": "string"
        },
        "phrase": {
          "description": "The words of the question that state this filter, copied verbatim.",
          "type": "string"
        }
      },
      "required": [
        "family",
        "phrase"
      ],
      "title": "FilterEvidence",
      "type": "object"
    },
    "Network": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "network",
          "type": "string"
        },
        "source": {
          "enum": [
            "sponsor",
            "drug",
            "condition",
            "country"
          ],
          "type": "string"
        },
        "target": {
          "description": "The same kind as source for co-occurrence, e.g. drug and drug.",
          "enum": [
            "sponsor",
            "drug",
            "condition",
            "country"
          ],
          "type": "string"
        },
        "link": {
          "anyOf": [
            {
              "enum": [
                "same_trial",
                "same_arm"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "'same_arm' when the question is about combinations; null lets the service decide."
        }
      },
      "required": [
        "kind",
        "source",
        "target",
        "link"
      ],
      "title": "Network",
      "type": "object"
    },
    "PlanFilters": {
      "additionalProperties": false,
      "properties": {
        "phases": {
          "description": "Empty unless the question restricts phase.",
          "items": {
            "enum": [
              "EARLY_PHASE1",
              "PHASE1",
              "PHASE2",
              "PHASE3",
              "PHASE4",
              "NA"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "statuses": {
          "description": "Empty unless the question restricts status. 'recruiting' means RECRUITING only.",
          "items": {
            "enum": [
              "NOT_YET_RECRUITING",
              "RECRUITING",
              "ENROLLING_BY_INVITATION",
              "ACTIVE_NOT_RECRUITING",
              "COMPLETED",
              "SUSPENDED",
              "TERMINATED",
              "WITHDRAWN",
              "AVAILABLE",
              "NO_LONGER_AVAILABLE",
              "TEMPORARILY_NOT_AVAILABLE",
              "APPROVED_FOR_MARKETING",
              "WITHHELD",
              "UNKNOWN"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "study_types": {
          "description": "Empty unless the question restricts study type.",
          "items": {
            "enum": [
              "INTERVENTIONAL",
              "OBSERVATIONAL",
              "EXPANDED_ACCESS"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "sponsor_classes": {
          "description": "Empty unless the question restricts the kind of sponsor, e.g. industry.",
          "items": {
            "enum": [
              "NIH",
              "FED",
              "OTHER_GOV",
              "INDIV",
              "INDUSTRY",
              "NETWORK",
              "AMBIG",
              "OTHER",
              "UNKNOWN"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "intervention_types": {
          "description": "Empty unless the question restricts the kind of intervention.",
          "items": {
            "enum": [
              "BEHAVIORAL",
              "BIOLOGICAL",
              "COMBINATION_PRODUCT",
              "DEVICE",
              "DIAGNOSTIC_TEST",
              "DIETARY_SUPPLEMENT",
              "DRUG",
              "GENETIC",
              "PROCEDURE",
              "RADIATION",
              "OTHER"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "evidence": {
          "description": "One item for every non-empty list above.",
          "items": {
            "$ref": "#/$defs/FilterEvidence"
          },
          "type": "array"
        },
        "date_field": {
          "anyOf": [
            {
              "enum": [
                "start_date",
                "primary_completion_date",
                "completion_date",
                "first_posted_date"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Which date year_from and year_to apply to; null lets the service decide."
        },
        "year_from": {
          "anyOf": [
            {
              "maximum": 2100,
              "minimum": 1900,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "First year, inclusive; null if the question gives none."
        },
        "year_to": {
          "anyOf": [
            {
              "maximum": 2100,
              "minimum": 1900,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Last year, inclusive; null if the question gives none."
        }
      },
      "required": [
        "phases",
        "statuses",
        "study_types",
        "sponsor_classes",
        "intervention_types",
        "evidence",
        "date_field",
        "year_from",
        "year_to"
      ],
      "title": "PlanFilters",
      "type": "object"
    },
    "Relate": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "relate",
          "type": "string"
        },
        "x": {
          "enum": [
            "enrollment",
            "duration_months",
            "site_count"
          ],
          "type": "string"
        },
        "y": {
          "enum": [
            "enrollment",
            "duration_months",
            "site_count"
          ],
          "type": "string"
        },
        "color_by": {
          "anyOf": [
            {
              "enum": [
                "phase",
                "overall_status",
                "study_type",
                "sponsor_class",
                "intervention_type",
                "sex",
                "age_group",
                "allocation",
                "masking",
                "primary_purpose",
                "has_results"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "x",
        "y",
        "color_by"
      ],
      "title": "Relate",
      "type": "object"
    },
    "Total": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "total",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Total",
      "type": "object"
    },
    "TrialList": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "trial_list",
          "type": "string"
        },
        "sort_by": {
          "enum": [
            "enrollment",
            "start_date",
            "completion_date",
            "first_posted_date"
          ],
          "type": "string"
        },
        "order": {
          "enum": [
            "desc",
            "asc"
          ],
          "type": "string"
        },
        "limit": {
          "anyOf": [
            {
              "maximum": 500,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Only when the user gives a number; otherwise null."
        }
      },
      "required": [
        "kind",
        "sort_by",
        "order",
        "limit"
      ],
      "title": "TrialList",
      "type": "object"
    },
    "Unsupported": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "unsupported",
          "type": "string"
        },
        "category": {
          "enum": [
            "not_about_clinical_trials",
            "needs_data_not_in_registry",
            "single_trial_lookup",
            "analysis_not_supported",
            "other"
          ],
          "type": "string"
        },
        "reason": {
          "description": "One sentence. No figures other than those in the question.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "category",
        "reason"
      ],
      "title": "Unsupported",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "interpretation": {
      "description": "One sentence restating what will be counted and how it is grouped. No figures other than those in the question.",
      "type": "string"
    },
    "entities": {
      "description": "Named drugs, conditions, sponsors, countries or other terms.",
      "items": {
        "$ref": "#/$defs/Entity"
      },
      "maxItems": 12,
      "type": "array"
    },
    "filters": {
      "$ref": "#/$defs/PlanFilters"
    },
    "analysis": {
      "anyOf": [
        {
          "$ref": "#/$defs/Aggregate"
        },
        {
          "$ref": "#/$defs/Total"
        },
        {
          "$ref": "#/$defs/Relate"
        },
        {
          "$ref": "#/$defs/Network"
        },
        {
          "$ref": "#/$defs/TrialList"
        },
        {
          "$ref": "#/$defs/Clarify"
        },
        {
          "$ref": "#/$defs/Unsupported"
        }
      ]
    },
    "chart_preference": {
      "anyOf": [
        {
          "enum": [
            "bar_chart",
            "time_series",
            "histogram",
            "scatter_plot",
            "network_graph",
            "table",
            "metric"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Only when the user names a chart form; otherwise null."
    }
  },
  "required": [
    "interpretation",
    "entities",
    "filters",
    "analysis",
    "chart_preference"
  ],
  "title": "QueryPlan",
  "type": "object"
}
