{
  "$defs": {
    "Aggregate": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "aggregate",
          "type": "string"
        },
        "dimension": {
          "description": "What trials are counted by: a category, a date or enrollment size.",
          "enum": [
            "phase",
            "overall_status",
            "study_type",
            "sponsor_class",
            "intervention_type",
            "sex",
            "age_group",
            "allocation",
            "masking",
            "primary_purpose",
            "has_results",
            "intervention_model",
            "country",
            "state",
            "sponsor",
            "drug",
            "condition",
            "start_date",
            "primary_completion_date",
            "completion_date",
            "first_posted_date",
            "enrollment"
          ],
          "type": "string"
        },
        "series": {
          "anyOf": [
            {
              "enum": [
                "phase",
                "overall_status",
                "study_type",
                "sponsor_class",
                "intervention_type",
                "sex",
                "age_group",
                "allocation",
                "masking",
                "primary_purpose",
                "has_results",
                "intervention_model"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "A second, closed dimension that splits the first; null otherwise."
        },
        "time_unit": {
          "anyOf": [
            {
              "enum": [
                "year",
                "quarter",
                "month"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Only for date dimensions; null lets the service use year."
        },
        "top_n": {
          "anyOf": [
            {
              "maximum": 500,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Only when the user asks for a number of items; otherwise null."
        },
        "statistic": {
          "anyOf": [
            {
              "enum": [
                "median",
                "mean",
                "sum"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null counts trials. 'median', 'mean' or 'sum' of the numeric field `of` instead."
        },
        "of": {
          "anyOf": [
            {
              "enum": [
                "enrollment",
                "duration_months",
                "site_count"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The numeric field of a statistic; null when counting."
        }
      },
      "required": [
        "kind",
        "dimension",
        "series",
        "time_unit",
        "top_n",
        "statistic",
        "of"
      ],
      "title": "Aggregate",
      "type": "object"
    },
    "Clarify": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "clarify",
          "type": "string"
        },
        "reason": {
          "enum": [
            "missing_entity",
            "ambiguous_request"
          ],
          "type": "string"
        },
        "missing": {
          "items": {
            "enum": [
              "drug_name",
              "condition",
              "sponsor",
              "country",
              "compare",
              "group_by"
            ],
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "kind",
        "reason",
        "missing"
      ],
      "title": "Clarify",
      "type": "object"
    },
    "Entity": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "drug",
            "condition",
            "sponsor",
            "country",
            "term"
          ],
          "type": "string"
        },
        "value": {
          "description": "The words exactly as they appear in the question or in a structured field. Never translate, expand, correct or add a name.",
          "type": "string"
        },
        "role": {
          "description": "'filter': every counted trial must match. 'compare': one side of an 'A vs B' comparison. 'exclude': no counted trial may match ('excluding', 'without', 'not involving').",
          "enum": [
            "filter",
            "compare",
            "exclude"
          ],
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value",
        "role"
      ],
      "title": "Entity",
      "type": "object"
    },
    "FilterEvidence": {
      "additionalProperties": false,
      "properties": {
        "family": {
          "enum": [
            "phases",
            "statuses",
            "exclude_statuses",
            "study_types",
            "sponsor_classes",
            "intervention_types",
            "sexes",
            "age_groups",
            "allocations",
            "maskings",
            "primary_purposes",
            "has_results",
            "intervention_models"
          ],
          "type": "string"
        },
        "phrase": {
          "description": "The words of the question that state this filter, copied verbatim.",
          "type": "string"
        }
      },
      "required": [
        "family",
        "phrase"
      ],
      "title": "FilterEvidence",
      "type": "object"
    },
    "Network": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "network",
          "type": "string"
        },
        "source": {
          "enum": [
            "sponsor",
            "drug",
            "condition",
            "country"
          ],
          "type": "string"
        },
        "target": {
          "description": "The same kind as source for co-occurrence, e.g. drug and drug.",
          "enum": [
            "sponsor",
            "drug",
            "condition",
            "country"
          ],
          "type": "string"
        },
        "link": {
          "anyOf": [
            {
              "enum": [
                "same_trial",
                "same_arm"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "'same_arm' when the question is about combinations; null lets the service decide."
        }
      },
      "required": [
        "kind",
        "source",
        "target",
        "link"
      ],
      "title": "Network",
      "type": "object"
    },
    "PlanFilters": {
      "additionalProperties": false,
      "properties": {
        "phases": {
          "description": "Empty unless the question restricts phase.",
          "items": {
            "enum": [
              "EARLY_PHASE1",
              "PHASE1",
              "PHASE2",
              "PHASE3",
              "PHASE4",
              "NA"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "statuses": {
          "description": "Empty unless the question restricts status. 'recruiting' means RECRUITING only.",
          "items": {
            "enum": [
              "NOT_YET_RECRUITING",
              "RECRUITING",
              "ENROLLING_BY_INVITATION",
              "ACTIVE_NOT_RECRUITING",
              "COMPLETED",
              "SUSPENDED",
              "TERMINATED",
              "WITHDRAWN",
              "AVAILABLE",
              "NO_LONGER_AVAILABLE",
              "TEMPORARILY_NOT_AVAILABLE",
              "APPROVED_FOR_MARKETING",
              "WITHHELD",
              "UNKNOWN"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "exclude_statuses": {
          "description": "Empty unless the question leaves statuses out, e.g. 'exclude terminated studies'.",
          "items": {
            "enum": [
              "NOT_YET_RECRUITING",
              "RECRUITING",
              "ENROLLING_BY_INVITATION",
              "ACTIVE_NOT_RECRUITING",
              "COMPLETED",
              "SUSPENDED",
              "TERMINATED",
              "WITHDRAWN",
              "AVAILABLE",
              "NO_LONGER_AVAILABLE",
              "TEMPORARILY_NOT_AVAILABLE",
              "APPROVED_FOR_MARKETING",
              "WITHHELD",
              "UNKNOWN"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "study_types": {
          "description": "Empty unless the question restricts study type.",
          "items": {
            "enum": [
              "INTERVENTIONAL",
              "OBSERVATIONAL",
              "EXPANDED_ACCESS"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "sponsor_classes": {
          "description": "Empty unless the question restricts the kind of sponsor, e.g. industry.",
          "items": {
            "enum": [
              "NIH",
              "FED",
              "OTHER_GOV",
              "INDIV",
              "INDUSTRY",
              "NETWORK",
              "AMBIG",
              "OTHER",
              "UNKNOWN"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "intervention_types": {
          "description": "Empty unless the question restricts the kind of intervention.",
          "items": {
            "enum": [
              "BEHAVIORAL",
              "BIOLOGICAL",
              "COMBINATION_PRODUCT",
              "DEVICE",
              "DIAGNOSTIC_TEST",
              "DIETARY_SUPPLEMENT",
              "DRUG",
              "GENETIC",
              "PROCEDURE",
              "RADIATION",
              "OTHER"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "sexes": {
          "description": "Empty unless the question restricts the sexes eligible.",
          "items": {
            "enum": [
              "FEMALE",
              "MALE",
              "ALL"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "age_groups": {
          "description": "Empty unless the question restricts the age group.",
          "items": {
            "enum": [
              "CHILD",
              "ADULT",
              "OLDER_ADULT"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "allocations": {
          "description": "Empty unless the question restricts allocation: 'randomized' is RANDOMIZED.",
          "items": {
            "enum": [
              "RANDOMIZED",
              "NON_RANDOMIZED",
              "NA"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "maskings": {
          "description": "Empty unless the question restricts masking, e.g. 'double-blind' is DOUBLE.",
          "items": {
            "enum": [
              "NONE",
              "SINGLE",
              "DOUBLE",
              "TRIPLE",
              "QUADRUPLE"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "primary_purposes": {
          "description": "Empty unless the question restricts the primary purpose, e.g. 'prevention trials'.",
          "items": {
            "enum": [
              "TREATMENT",
              "PREVENTION",
              "DIAGNOSTIC",
              "ECT",
              "SUPPORTIVE_CARE",
              "SCREENING",
              "HEALTH_SERVICES_RESEARCH",
              "BASIC_SCIENCE",
              "DEVICE_FEASIBILITY",
              "OTHER"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "has_results": {
          "description": "Empty unless the question restricts whether results are posted: ['true'] or ['false'].",
          "items": {
            "enum": [
              "true",
              "false"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "intervention_models": {
          "description": "Empty unless the question restricts the assignment model, e.g. 'crossover'.",
          "items": {
            "enum": [
              "PARALLEL",
              "CROSSOVER",
              "FACTORIAL",
              "SEQUENTIAL",
              "SINGLE_GROUP"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "evidence": {
          "description": "One item for every non-empty list above.",
          "items": {
            "$ref": "#/$defs/FilterEvidence"
          },
          "type": "array"
        },
        "date_field": {
          "anyOf": [
            {
              "enum": [
                "start_date",
                "primary_completion_date",
                "completion_date",
                "first_posted_date"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Which date year_from and year_to apply to; null lets the service decide."
        },
        "year_from": {
          "anyOf": [
            {
              "maximum": 2100,
              "minimum": 1900,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "First year, inclusive; null if the question gives none."
        },
        "year_to": {
          "anyOf": [
            {
              "maximum": 2100,
              "minimum": 1900,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Last year, inclusive; null if the question gives none."
        }
      },
      "required": [
        "phases",
        "statuses",
        "exclude_statuses",
        "study_types",
        "sponsor_classes",
        "intervention_types",
        "sexes",
        "age_groups",
        "allocations",
        "maskings",
        "primary_purposes",
        "has_results",
        "intervention_models",
        "evidence",
        "date_field",
        "year_from",
        "year_to"
      ],
      "title": "PlanFilters",
      "type": "object"
    },
    "Relate": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "relate",
          "type": "string"
        },
        "x": {
          "enum": [
            "enrollment",
            "duration_months",
            "site_count"
          ],
          "type": "string"
        },
        "y": {
          "enum": [
            "enrollment",
            "duration_months",
            "site_count"
          ],
          "type": "string"
        },
        "color_by": {
          "anyOf": [
            {
              "enum": [
                "phase",
                "overall_status",
                "study_type",
                "sponsor_class",
                "intervention_type",
                "sex",
                "age_group",
                "allocation",
                "masking",
                "primary_purpose",
                "has_results",
                "intervention_model"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "x",
        "y",
        "color_by"
      ],
      "title": "Relate",
      "type": "object"
    },
    "Total": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "total",
          "type": "string"
        },
        "statistic": {
          "anyOf": [
            {
              "enum": [
                "median",
                "mean",
                "sum"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null counts trials. 'median', 'mean' or 'sum' of the numeric field `of` instead."
        },
        "of": {
          "anyOf": [
            {
              "enum": [
                "enrollment",
                "duration_months",
                "site_count"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The numeric field of a statistic; null when counting."
        }
      },
      "required": [
        "kind",
        "statistic",
        "of"
      ],
      "title": "Total",
      "type": "object"
    },
    "TrialList": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "trial_list",
          "type": "string"
        },
        "sort_by": {
          "enum": [
            "enrollment",
            "start_date",
            "completion_date",
            "first_posted_date"
          ],
          "type": "string"
        },
        "order": {
          "enum": [
            "desc",
            "asc"
          ],
          "type": "string"
        },
        "limit": {
          "anyOf": [
            {
              "maximum": 500,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Only when the user gives a number; otherwise null."
        }
      },
      "required": [
        "kind",
        "sort_by",
        "order",
        "limit"
      ],
      "title": "TrialList",
      "type": "object"
    },
    "Unsupported": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "unsupported",
          "type": "string"
        },
        "category": {
          "enum": [
            "not_about_clinical_trials",
            "needs_data_not_in_registry",
            "single_trial_lookup",
            "analysis_not_supported",
            "other"
          ],
          "type": "string"
        },
        "reason": {
          "description": "One sentence. No figures other than those in the question.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "category",
        "reason"
      ],
      "title": "Unsupported",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "interpretation": {
      "description": "One sentence restating what will be counted and how it is grouped. No figures other than those in the question.",
      "type": "string"
    },
    "entities": {
      "description": "Named drugs, conditions, sponsors, countries or other terms.",
      "items": {
        "$ref": "#/$defs/Entity"
      },
      "maxItems": 12,
      "type": "array"
    },
    "filters": {
      "$ref": "#/$defs/PlanFilters"
    },
    "analysis": {
      "anyOf": [
        {
          "$ref": "#/$defs/Aggregate"
        },
        {
          "$ref": "#/$defs/Total"
        },
        {
          "$ref": "#/$defs/Relate"
        },
        {
          "$ref": "#/$defs/Network"
        },
        {
          "$ref": "#/$defs/TrialList"
        },
        {
          "$ref": "#/$defs/Clarify"
        },
        {
          "$ref": "#/$defs/Unsupported"
        }
      ]
    },
    "chart_preference": {
      "anyOf": [
        {
          "enum": [
            "bar_chart",
            "time_series",
            "histogram",
            "scatter_plot",
            "network_graph",
            "table",
            "metric"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Only when the user names a chart form; otherwise null."
    },
    "unapplied": {
      "description": "Words copied from the question that ask to make part of the chart look different (highlight, mark, annotate, colour); empty otherwise, and empty for most questions. Never a counting rule or a wish for a clear chart, and never a reason for 'unsupported'.",
      "items": {
        "type": "string"
      },
      "maxItems": 5,
      "type": "array"
    }
  },
  "required": [
    "interpretation",
    "entities",
    "filters",
    "analysis",
    "chart_preference",
    "unapplied"
  ],
  "title": "QueryPlan",
  "type": "object"
}
